diff --git a/hack/tools/vendor/sigs.k8s.io/kube-api-linter/pkg/analysis/defaults/analyzer.go b/hack/tools/vendor/sigs.k8s.io/kube-api-linter/pkg/analysis/defaults/analyzer.go
new file mode 100644
index 00000000000..9dc5c6db5e7
--- /dev/null
+++ b/hack/tools/vendor/sigs.k8s.io/kube-api-linter/pkg/analysis/defaults/analyzer.go
@@ -0,0 +1,397 @@
+/*
