+		serviceAttachments: nil,
+	})
+	gcpPSC := newGCPPSC("", "")
+	if err := r.reconcileGCPPrivateServiceConnectSpec(context.Background(), gcpPSC, nil); err != nil {
+		t.Errorf("unexpected error: %v", err)
