+func machineWithOSImage(name, osImage string) *v1beta1.Machine {
+	return &v1beta1.Machine{
+		ObjectMeta: metav1.ObjectMeta{
+			Name: name,
+		},
+		Status: v1beta1.MachineStatus{
+			NodeInfo: &corev1.NodeSystemInfo{
+				OSImage: osImage,
+			},
+		},
+	}
+}
