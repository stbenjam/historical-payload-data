+					ObjectMeta: metav1.ObjectMeta{
+						Name:      "m1",
+						Namespace: "clusters-test-cluster",
+						Annotations: map[string]string{
+							nodePoolAnnotation: "clusters/test-nodepool",
+						},
+					},
