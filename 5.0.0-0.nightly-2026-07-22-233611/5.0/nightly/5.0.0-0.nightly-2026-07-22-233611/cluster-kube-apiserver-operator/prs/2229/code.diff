-
-	if c.dirty {
-		if c.con.Major() != v.Major() {
-			return true, nil
-		}
-		if c.con.Minor() != v.Minor() && !c.minorDirty {
-			return true, nil
-		} else if c.minorDirty {
-			return false, fmt.Errorf("%s is equal to %s", v, c.orig)
-		} else if c.con.Patch() != v.Patch() && !c.patchDirty {
-			return true, nil
-		} else if c.patchDirty {
