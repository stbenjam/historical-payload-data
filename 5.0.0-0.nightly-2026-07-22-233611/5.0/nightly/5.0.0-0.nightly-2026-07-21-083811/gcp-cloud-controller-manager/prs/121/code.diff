+			}
+		}
+
+		return gce
+	}
+
+	nodeNames := func(nodes []*v1.Node) sets.Set[string] {
+		names := sets.New[string]()
+		for _, n := range nodes {
+			names.Insert(n.Name)
+		}
+		return names
+	}
+
+	for name, tc := range map[string]struct {
