+      - name: client-tls
+        secret:
+          defaultMode: 416
+          secretName: etcd-client-tls
+      - configMap:
+          defaultMode: 420
+          name: etcd-ca
+        name: etcd-ca
+      - configMap:
+          defaultMode: 420
+          name: etcd-metrics-ca
+        name: etcd-metrics-ca
