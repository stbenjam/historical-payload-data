+        - /bin/bash
+        env:
+        - name: NAMESPACE
+          valueFrom:
+            fieldRef:
+              apiVersion: v1
+              fieldPath: metadata.namespace
+        image: etcd
+        imagePullPolicy: IfNotPresent
+        name: reset-member
+        resources: {}
+        terminationMessagePolicy: FallbackToLogsOnError
+        volumeMounts:
+        - mountPath: /var/lib
+          name: data
+        - mountPath: /etc/etcd/tls/server
