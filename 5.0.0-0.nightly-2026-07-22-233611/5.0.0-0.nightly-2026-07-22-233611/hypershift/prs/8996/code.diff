+	elbClient.EXPECT().DescribeLoadBalancers(gomock.Any(), gomock.Any()).Return(
+		&elasticloadbalancingv2.DescribeLoadBalancersOutput{LoadBalancers: []elbv2types.LoadBalancer{}}, nil,
+	).AnyTimes()
+
+	hcpNs := "test-ns-test-hc"
