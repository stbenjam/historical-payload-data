diff --git a/internal/operators/openshiftai/templates/custom/amd_hardwareprofile.yaml b/internal/operators/openshiftai/templates/custom/amd_hardwareprofile.yaml
new file mode 100644
index 000000000000..0821c909fdb2
--- /dev/null
+++ b/internal/operators/openshiftai/templates/custom/amd_hardwareprofile.yaml
@@ -0,0 +1,25 @@
+{{ if .Cluster }}
+{{ range .Cluster.MonitoredOperators }}
+{{ if eq .Name "amd-gpu" }}
+apiVersion: infrastructure.opendatahub.io/v1alpha1
+kind: HardwareProfile
+metadata:
+  namespace: redhat-ods-applications
+  name: amd-gpu
+spec:
+  identifiers:
+  - identifier: amd.com/gpu
+    displayName: AMD GPU
+    resourceType: Accelerator
+    defaultCount: 1
+    minCount: 0
+  scheduling:
+    type: Node
+    node:
+      tolerations:
+      - key: amd.com/gpu
+        operator: Exists
+        effect: NoSchedule
+{{ end }}
+{{ end }}
+{{ end }}
\ No newline at end of file
