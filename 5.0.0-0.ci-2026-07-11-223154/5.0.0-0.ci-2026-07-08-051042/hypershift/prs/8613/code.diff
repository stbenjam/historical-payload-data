+
+	t.Run("When called for etcd-1 it should use the correct slice name and hostname", func(t *testing.T) {
+		g := NewGomegaWithT(t)
+		pod1 := &corev1.Pod{
+			ObjectMeta: metav1.ObjectMeta{
+				Name:      "etcd-1",
+				Namespace: namespace,
