+//
+// Safe for initialization phase (doesn't use Gomega).
+func duplicateFileToTempOrEmpty(srcPath, destPrefix string, verbose bool) string {
+	tempPath, err := duplicateFileToTempSafe(srcPath, destPrefix)
+	if err != nil {
