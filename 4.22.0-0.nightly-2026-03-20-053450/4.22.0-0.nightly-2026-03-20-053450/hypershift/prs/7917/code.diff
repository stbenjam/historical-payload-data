+			name: "When machines exist with NodeInfo it should populate NodesInfo",
+			machines: []client.Object{
+				&v1beta1.Machine{
+					ObjectMeta: metav1.ObjectMeta{
+						Name:      "m1",
+						Namespace: "clusters-test-cluster",
