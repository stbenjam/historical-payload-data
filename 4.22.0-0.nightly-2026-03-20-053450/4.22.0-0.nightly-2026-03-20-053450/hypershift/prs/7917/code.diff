+					Namespace: "clusters",
+				},
+				Spec: hyperv1.NodePoolSpec{
+					ClusterName: "test-cluster",
+				},
+				Status: hyperv1.NodePoolStatus{
+					Version: "4.18.12",
+					NodesInfo: hyperv1.NodePoolNodesInfo{
