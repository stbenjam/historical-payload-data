+	var ipv6ComputeSubnets []*net.IPNet
+	if a.isDualStack {
+		ipv6ComputeSubnets, err = a.SplitIPv6ComputeSubnets(numSubnets)
+		if err != nil {
+			return err
+		}
+		ipv6Count = len(ipv6ComputeSubnets)
+	}
