+			name: "sts-creds without role-arn",
+			opts: &FixDrOidcIamOptions{
+				HCName:       "my-cluster",
+				HCNamespace:  "clusters",
+				STSCredsFile: "/path/to/sts-creds",
+			},
+			expectedErr: "role-arn is required when using sts-creds",
+		},
+		{
+			name: "role-arn without sts-creds",
+			opts: &FixDrOidcIamOptions{
+				HCName:      "my-cluster",
+				HCNamespace: "clusters",
