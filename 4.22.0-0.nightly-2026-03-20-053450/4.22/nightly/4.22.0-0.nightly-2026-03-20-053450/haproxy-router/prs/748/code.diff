+	NetworkDiagnosticsNoOpinion NetworkDiagnosticsMode = ""
+	// NetworkDiagnosticsAll means that all network diagnostics checks are enabled
+	NetworkDiagnosticsAll NetworkDiagnosticsMode = "All"
