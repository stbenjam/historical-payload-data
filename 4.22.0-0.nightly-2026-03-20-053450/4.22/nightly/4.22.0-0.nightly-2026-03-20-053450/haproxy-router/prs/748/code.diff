+	// +listType=atomic
+	// +optional
+	Name []string `json:"name,omitempty"`
+
+	// email is the list of claims whose values should be used as the email address. Optional.
+	// If unspecified, no email is set for the identity
+	// +listType=atomic
+	// +optional
+	Email []string `json:"email,omitempty"`
