+			name: "TLS 1.3 server rejects TLS 1.2 client",
+			servingInfo: configv1.HTTPServingInfo{
+				ServingInfo: configv1.ServingInfo{
+					BindAddress:   "localhost:5000",
+					MinTLSVersion: "VersionTLS13",
+				},
+			},
+			clientTLSConfig: &tls.Config{
