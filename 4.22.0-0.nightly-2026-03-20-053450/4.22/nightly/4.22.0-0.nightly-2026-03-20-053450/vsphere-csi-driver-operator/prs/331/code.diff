+					Name:   "test-node",
+					Labels: tt.labels,
+				},
+				Spec: v1.NodeSpec{
+					ProviderID: tt.providerID,
+				},
 			}
+			err := validateVsphereNode(node, featureGateEnabled)
+			assert.Equalf(t, tt.expectedError, err, "labels=%v providerID=%q", tt.labels, tt.providerID)
 		})
 	}
 }
