+func TestIsVSphereNode_FeatureGateVSphereMixedNodeEnv(t *testing.T) {
+	featureGateEnabled := featuregates.NewFeatureGate(
+		[]configv1.FeatureGateName{features.FeatureGateVSphereMixedNodeEnv},
