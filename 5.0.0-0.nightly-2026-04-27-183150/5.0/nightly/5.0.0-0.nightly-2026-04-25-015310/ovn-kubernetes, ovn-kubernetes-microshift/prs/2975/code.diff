+func getKubeConfig() (*restclient.Config, error) {
+	kubeConfig := os.Getenv("KUBECONFIG")
+	if kubeConfig == "" {
+		return nil, fmt.Errorf("KUBECONFIG env variable not set")
+	}
+	if _, err := os.Stat(kubeConfig); err != nil {
