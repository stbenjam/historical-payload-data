+		return nil, fmt.Errorf("failed to generate key pair: %w", err)
+	}
+	subjectKeyId, err := SubjectKeyIDFromPublicKey(publicKey)
+	if err != nil {
+		return nil, fmt.Errorf("failed to compute subject key ID: %w", err)
+	}
