+// Optional: WithLifetime (defaults to DefaultCertificateLifetimeDuration).
+func (ca *CA) NewClientCertificate(u user.Info, keyGen KeyPairGenerator, opts ...CertificateOption) (*TLSCertificateConfig, error) {
