+        }
+
+        .output-content .log-warning {
+            color: #d29922;
+        }
+
+        .output-content .log-success {
+            color: #3fb950;
+        }
+
+        .output-content .log-skip {
+            color: #a371f7;
+        }
+
+        /* Empty State */
+        .empty-state {
+            text-align: center;
+            padding: 64px 24px;
+            color: var(--text-secondary);
+        }
+
+        .empty-state h3 {
+            font-size: 18px;
+            margin-bottom: 8px;
+            color: var(--text-primary);
+        }
+
+        /* Loading */
+        .loading {
