+						{
+							Type:    capiv1.MachineNodeHealthyCondition,
+							Status:  corev1.ConditionFalse,
+							Reason:  capiv1.NodeConditionsFailedReason,
+							Message: "Condition Ready on node is reporting status False",
+						},
+					},
+				},
