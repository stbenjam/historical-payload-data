+func newFakeClient(objs ...client.Object) client.WithWatch {
+	scheme := runtime.NewScheme()
+	if err := configv1.AddToScheme(scheme); err != nil {
+		panic(err)
+	}
+
+	return fake.NewClientBuilder().
+		WithScheme(scheme).
+		WithObjects(objs...).
+		WithStatusSubresource(&configv1.ClusterOperator{}).
+		Build()
+}
