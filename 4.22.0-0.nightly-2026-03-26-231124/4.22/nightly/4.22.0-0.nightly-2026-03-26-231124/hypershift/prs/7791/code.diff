+				},
+				Data: map[string]string{"subnetIDs": `["subnet-a","subnet-b"]`},
+			},
+			expectedQueued: 0,
+		},
+	}
+
+	for _, tc := range testCases {
+		t.Run(tc.name, func(t *testing.T) {
+			g := NewWithT(t)
+
+			mgr := &fakeManager{}
