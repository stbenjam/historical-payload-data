+			componentName: "unknown-component",
+			wantNil:       true,
+			wantCached:    true,
+		},
+		{
+			name:          "When called twice for same component, it should return cached regex",
+			metricsSet:    metrics.MetricsSetTelemetry,
+			componentName: "etcd",
+			wantNil:       false,
+			wantCached:    true,
+		},
