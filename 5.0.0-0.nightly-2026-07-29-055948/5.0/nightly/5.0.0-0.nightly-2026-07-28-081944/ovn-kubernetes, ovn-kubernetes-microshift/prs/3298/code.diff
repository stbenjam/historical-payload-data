+					expectedChain += "\n" + fmt.Sprintf(tmpl, cidr, cidr)
+				}
+			}
+
+			if err = MatchNFTRules(expectedChain, fake.Dump()); err != nil {
+				t.Fatalf("expected egressIP NFT rules to match: %v", err)
+			}
