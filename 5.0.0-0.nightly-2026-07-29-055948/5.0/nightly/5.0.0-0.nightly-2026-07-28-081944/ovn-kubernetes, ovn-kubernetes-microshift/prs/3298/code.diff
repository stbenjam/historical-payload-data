+			oldPod, err = kube.GetPod(pod.Namespace, pod.Name)
+		} else {
+			oldPod, err = podLister.Pods(pod.Namespace).Get(pod.Name)
+		}
 		if err != nil {
 			return err
 		}
@@ -58,8 +73,13 @@ func UpdatePodWithRetryOrRollback(podLister listers.PodLister, kube kube.Interfa
