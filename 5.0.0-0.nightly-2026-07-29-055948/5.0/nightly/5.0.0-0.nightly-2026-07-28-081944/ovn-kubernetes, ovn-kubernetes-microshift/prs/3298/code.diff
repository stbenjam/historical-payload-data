+	port := &vswitchd.Port{UUID: portUUID, Name: "p1"}
+	orphan := &vswitchd.Port{UUID: orphanPortUUID, Name: "orphan"}
+	ovs := &vswitchd.OpenvSwitch{UUID: "root-ovs", Bridges: []string{bridgeAUUID, bridgeBUUID}}
