diff --git a/manifests/03-networkpolicy-operator-allow-egress.yaml b/manifests/03-networkpolicy-operator-allow-egress.yaml
new file mode 100644
index 000000000..f6d2c1086
--- /dev/null
+++ b/manifests/03-networkpolicy-operator-allow-egress.yaml
@@ -0,0 +1,28 @@
+apiVersion: networking.k8s.io/v1
+kind: NetworkPolicy
+metadata:
+  name: allow-egress
+  namespace: openshift-console-operator
+  annotations:
+    include.release.openshift.io/hypershift: "true"
+    include.release.openshift.io/ibm-cloud-managed: "true"
+    include.release.openshift.io/self-managed-high-availability: "true"
+    include.release.openshift.io/single-node-developer: "true"
+    capability.openshift.io/name: Console
+    kubernetes.io/description: >-
+      Allow all egress from the console operator pod in the
+      openshift-console-operator namespace. The operator controller
+      needs Kubernetes API server access to watch and reconcile
+      console-related resources. Because the API server address and
+      port vary per cluster and the server runs on the host network,
+      they cannot be statically restricted in a NetworkPolicy managed
+      by the cluster-version operator. Opening all egress also covers
+      DNS resolution needs.
+spec:
+  podSelector:
+    matchLabels:
+      name: console-operator
+  egress:
+  - {}
+  policyTypes:
+  - Egress
diff --git a/manifests/03-networkpolicy-operator-allow-metrics-ingress.yaml b/manifests/03-networkpolicy-operator-allow-metrics-ingress.yaml
new file mode 100644
index 000000000..45bba5c5f
--- /dev/null
+++ b/manifests/03-networkpolicy-operator-allow-metrics-ingress.yaml
@@ -0,0 +1,28 @@
+apiVersion: networking.k8s.io/v1
+kind: NetworkPolicy
+metadata:
+  name: allow-metrics-ingress
+  namespace: openshift-console-operator
+  annotations:
+    include.release.openshift.io/hypershift: "true"
+    include.release.openshift.io/ibm-cloud-managed: "true"
+    include.release.openshift.io/self-managed-high-availability: "true"
+    include.release.openshift.io/single-node-developer: "true"
+    capability.openshift.io/name: Console
+    kubernetes.io/description: >-
+      Allow ingress to ports 60000 and 8443 on the console operator pod.
+      This is a NetworkPolicy managed by the cluster-version operator
+      that allows any source to reach port 60000 for Prometheus scraping
+      and port 8443 for Service/Route access (healthz/readyz and metrics).
+spec:
+  podSelector:
+    matchLabels:
+      name: console-operator
+  ingress:
+  - ports:
+    - protocol: TCP
+      port: 60000
+    - protocol: TCP
+      port: 8443
+  policyTypes:
+  - Ingress
diff --git a/manifests/03-networkpolicy-operator-default-deny.yaml b/manifests/03-networkpolicy-operator-default-deny.yaml
new file mode 100644
index 000000000..061f82643
--- /dev/null
+++ b/manifests/03-networkpolicy-operator-default-deny.yaml
@@ -0,0 +1,21 @@
+apiVersion: networking.k8s.io/v1
+kind: NetworkPolicy
+metadata:
+  name: default-deny
+  namespace: openshift-console-operator
+  annotations:
+    include.release.openshift.io/hypershift: "true"
+    include.release.openshift.io/ibm-cloud-managed: "true"
+    include.release.openshift.io/self-managed-high-availability: "true"
+    include.release.openshift.io/single-node-developer: "true"
+    capability.openshift.io/name: Console
+    kubernetes.io/description: >-
+      Default deny all ingress and egress traffic in the
+      openshift-console-operator namespace. The policy improves
+      network isolation by ensuring that pods only communicate
+      through explicitly allowed policies.
+spec:
+  podSelector: {}
+  policyTypes:
+  - Ingress
+  - Egress
