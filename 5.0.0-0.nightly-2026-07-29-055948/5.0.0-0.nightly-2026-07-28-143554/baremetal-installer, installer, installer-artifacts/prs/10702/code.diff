+func buildBootstrapKargs(arch string, fips bool) []byte {
+	consoleDevice := map[string]string{
+		"x86_64":  "ttyS0,115200n8",
+		"aarch64": "ttyAMA0,115200",
+		"s390x":   "ttysclp0",
+		"ppc64le": "hvc0",
+	}
+	var kargs string
+	if dev, ok := consoleDevice[arch]; ok {
+		kargs += " console=" + dev
+	}
+	if fips {
+		kargs += " fips=1"
+	}
+	if kargs == "" {
+		return nil
+	}
+	return []byte(kargs + "\n")
+}
